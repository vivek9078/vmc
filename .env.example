# ---- Authentication (custom, session-cookie based) ----
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# Bootstrap Super Admin — created automatically the first time anyone logs
# in against a fresh database/data.xlsx (see ensureBootstrapData() in
# src/lib/auth.ts). Change the password after your first login.
SUPER_ADMIN_EMAIL=admin@vietnamdmc.com
SUPER_ADMIN_PASSWORD=

# ---- Storage ----
# No configuration needed. All data lives in database/data.xlsx, created
# automatically on first run (see src/lib/excel.ts). Nothing external, no
# credentials, no service account.

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
